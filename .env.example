DISCORD_BOT_TOKEN=
# Mesmo segredo no site (openssl rand -hex 32).
MUSIC_SHARED_SECRET=
HOST=127.0.0.1
PORT=3031
# Opcional, para busca por nome/link no Spotify. O áudio é encontrado no YouTube.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Para importar playlists: npm run spotify:connect (salva a autorização automaticamente).
SPOTIFY_REFRESH_TOKEN=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8890/callback
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
# Encerra e limpa a fila depois de 60 s sem ouvintes.
EMPTY_TIMEOUT_MS=60000

# Markov: somente canal geral do servidor Amigos. Message Content Intent deve estar ativo.
MARKOV_ENABLED=false
MARKOV_CHANNEL_ID=1379585304029171805
MARKOV_DB_PATH=/app/data/markov.sqlite

# Biblioteca de playlists, favoritas e histórico musical (volume persistente).
MUSIC_DB_PATH=/app/data/music.sqlite

# IA ocasional: sem chave, usa somente Markov.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_REPLY_CHANCE=0.15
OPENAI_DAILY_LIMIT=30
# Um GIF em parte das respostas, sem mensagens extras. 0 desativa.
MARKOV_MEDIA_CHANCE=0.175

# Provedor remoto gratuito. Não use a chave OpenRouter em OPENAI_API_KEY.
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Voz opcional: só a próxima fala de quem clicar. Nenhum modelo pago é aceito.
VOICE_COMMANDS_ENABLED=false
VOICE_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
# Teto interno de 10 tentativas/dia UTC, inclusive falhas. 0 desliga envios.
VOICE_DAILY_LIMIT=10
VOICE_USAGE_DB_PATH=/app/data/voice.sqlite

# Opcional: Last.fm (desativado enquanto uma das credenciais estiver vazia).
LASTFM_API_KEY=
LASTFM_API_SECRET=
LASTFM_DB_PATH=/app/data/lastfm.sqlite
