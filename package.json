{
  "name": "coffee-music-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "node --env-file=.env dist/index.js",
    "start:container": "node dist/index.js",
    "test": "node --test test/*.test.js",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "dev": "node --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "spotify:connect": "node --env-file=.env src/music/spotify-connect.ts",
    "diagnose:music": "node --env-file=.env src/music/diagnose.ts"
  },
  "dependencies": {
    "@discordjs/voice": "0.19.2",
    "discord.js": "14.28.1",
    "opusscript": "0.1.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "prettier": "3.9.10",
    "typescript": "5.9.3"
  }
}
